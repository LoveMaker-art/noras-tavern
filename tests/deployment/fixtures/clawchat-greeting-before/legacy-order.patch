+    def has_sent_activation_bootstrap(
+        self,
+        *,
+        platform: str,
+        account_id: str,
+        user_id: str,
+    ) -> bool:
+        self.initialize()
+        if self._disabled or not user_id:
+            return False
+        conn = sqlite3.connect(self.db_path)
+        try:
+            row = conn.execute(
+                "SELECT bootstrap_sent, conversation_id FROM activations "
+                "WHERE platform = ? AND account_id = ? AND user_id = ?",
+                (platform, account_id, user_id),
+            ).fetchone()
+            return bool(row and row[0] == 1 and row[1])
+        finally:
+            conn.close()
