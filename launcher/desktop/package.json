{
  "name": "nora-tavern-launcher",
  "version": "2.1.1",
  "private": true,
  "author": "Nora Tavern",
  "description": "Desktop shell for the Nora Tavern local launcher.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:mock": "electron . --nora-mock=uninstalled --nora-watch",
    "dev:mock:installed": "electron . --nora-mock=installed --nora-watch",
    "dev:real": "electron . --nora-watch",
    "pack:mac": "electron-builder --mac dmg zip",
    "pack:mac:arm64": "electron-builder --mac dmg zip --arm64",
    "pack:mac:x64": "electron-builder --mac dmg zip --x64",
    "pack:win": "electron-builder --win nsis portable zip --x64",
    "pack:win:x64": "electron-builder --win nsis zip --x64",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "semver": "7.8.5",
    "fs-native-extensions": "1.5.1"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "art.lovemaker.nora-tavern-launcher",
    "productName": "诺拉·酒馆",
    "icon": "../assets/nora-launcher-portrait.png",
    "artifactName": "Nora-Tavern-Launcher-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "model-config.js",
      "preload.js",
      "runtime.js",
      "releases.js",
      "system-update.js",
      "legacy-recovery-worker.js",
      "system-update-executor.js",
      "skill-update.js",
      "local-release.js",
      "launcher-update.js",
      "test-build.js",
      "install-cleanup.js",
      "install-location.js",
      "uninstall.js",
      "runtime-worker.js",
      "diagnostics.js",
      "native-crash.js",
      "telemetry.js",
      "operation-log-delivery.js",
      "launcher-errors.js",
      "error-presentation.js",
      "fault-packet.js",
      "telemetry-contract.json",
      "release-network.js",
      "release-sources.js",
      "release-sources.json",
      "process-output.js",
      "operation-lock.js",
      "os-lock.js",
      "operation-lock-worker.js",
      "operation-delegate.js",
      "operation-state.js",
      "operation-result.js",
      "evidence-store.js",
      "operation-inspection.js",
      "operation-policy.js",
      "managed-python.js",
      "runtime-transaction.js",
      "tree-integrity.js",
      "operation-cli.js",
      "launcher-capability.js"
    ],
    "extraResources": [
      {
        "from": "replace-launcher.py",
        "to": "replace-launcher.py"
      },
      {
        "from": "../nora_profile.py",
        "to": "nora_profile.py"
      },
      {
        "from": "../nora_system.py",
        "to": "nora_system.py"
      },
      {
        "from": "../launcher-conversation-prototype.html",
        "to": "launcher-conversation-prototype.html"
      },
      {
        "from": "../launcher-controller.js",
        "to": "launcher-controller.js"
      },
      {
        "from": "../launcher_services.py",
        "to": "launcher_services.py"
      },
      {
        "from": "../launcher_bridge.py",
        "to": "launcher_bridge.py"
      },
      {
        "from": "../model_config.py",
        "to": "model_config.py"
      },
      {
        "from": "../bootstrap.py",
        "to": "bootstrap.py"
      },
      {
        "from": "../update_recovery.py",
        "to": "update_recovery.py"
      },
      {
        "from": "../error_diagnostics.py",
        "to": "error_diagnostics.py"
      },
      {
        "from": "../assets",
        "to": "assets"
      },
      {
        "from": "../payload",
        "to": "payload"
      },
      {
        "from": "../operation_control.py",
        "to": "operation_control.py"
      },
      {
        "from": "../operation_node.mjs",
        "to": "operation_node.mjs"
      },
      {
        "from": "../operation_evidence.py",
        "to": "operation_evidence.py"
      },
      {
        "from": "../operation-budget.json",
        "to": "operation-budget.json"
      },
      {
        "from": "../operation_cli.py",
        "to": "operation_cli.py"
      },
      {
        "from": "../first_install.py",
        "to": "first_install.py"
      },
      {
        "from": "../update_paths.py",
        "to": "update_paths.py"
      },
      {
        "from": "../mcp_probe.mjs",
        "to": "mcp_probe.mjs"
      },
      {
        "from": "../operation-delegate.js",
        "to": "operation-delegate.js"
      }
    ],
    "mac": {
      "category": "public.app-category.games",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "include": "uninstall.nsh",
      "artifactName": "Nora-Tavern-Launcher-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Nora-Tavern-Launcher-${version}-win-${arch}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/fs-native-extensions/prebuilds/**"
    ]
  }
}
