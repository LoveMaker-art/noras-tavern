# Required for standalone story generation.
TAVERN_MODEL_BASE=https://your-provider.example/v1
TAVERN_MODEL_KEY=replace-with-your-key
TAVERN_MODEL=your-model-id

# Runtime and persistent state.
TAVERN_HOST=127.0.0.1
TAVERN_PORT=8799
TAVERN_STATE_DIR=./tavern-state

# Optional generation controls.
TAVERN_MODEL_TEMP=0.85
TAVERN_ACTOR_MAX_TOKENS=10000
TAVERN_MODEL_TIMEOUT=120

# Optional story-ledger model. Leave empty to use TAVERN_MODEL.
TAVERN_MEMORY_MODEL=

# Optional TTS endpoint. Leave unset to keep speech unavailable.
# TAVERN_TTS_BASE=https://your-provider.example/v1
# TAVERN_TTS_KEY=replace-with-your-key
