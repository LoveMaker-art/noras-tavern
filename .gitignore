.DS_Store

# Rebuildable local code index
.codebase-memory/

# Reproducible dependencies and generated output
**/node_modules/
**/.cache/
**/coverage/
release/

# Private production-state snapshot. Keep only its documentation in Git.
local-state/**
!local-state/README.md

# Runtime and credential material must never enter source control.
*.log
*.pid
*.token
*.pyc
__pycache__/
nora-mcp/dist/
nora-mcp/docs/upstream-st-index.*
.env
.env.*
secrets.json*
cookie-secret.txt
