diff --git a/tests/nora_protocol.test.ts b/tests/nora_protocol.test.ts
new file mode 100644
index 0000000..11b90b6
--- /dev/null
+++ b/tests/nora_protocol.test.ts
@@ -0,0 +1,151 @@
+import {
+    envelopeToCommands,
+    extractNoraMvuCommands,
+    formatNoraMvuUpdateBlock,
+    isExplicitNoraMvuNoop,
+    parseNoraMvuEnvelope,
+} from '@/function/nora_protocol';
+import { getLastVariableUpdateDiagnostics, updateVariables } from '@/function/update_variables';
+
+describe('Nora MVU v1 protocol', () => {
+    test('translates every operation into the pinned MVU command interface', () => {
+        const envelope = parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1',
+            operations: [
+                { op: 'set', path: ['角色', '好感度'], value: 44 },
+                { op: 'increment', path: ['角色', '好感度'], amount: 2 },
+                { op: 'append', path: ['角色', '背包'], value: '钥匙' },
+                { op: 'insert', path: ['角色', '背包'], index: 0, value: '车票' },
+                { op: 'delete', path: ['角色', '背包', 1] },
+                { op: 'move', from: ['角色', '旧位置'], path: ['角色', '当前位置'] },
+            ],
+        });
+
+        expect(envelopeToCommands(envelope)).toEqual([
+            expect.objectContaining({ type: 'set', args: ['["角色"]["好感度"]', '44'] }),
+            expect.objectContaining({ type: 'add', args: ['["角色"]["好感度"]', '2'] }),
+            expect.objectContaining({ type: 'insert', args: ['["角色"]["背包"]', '"-"', '"钥匙"'] }),
+            expect.objectContaining({ type: 'insert', args: ['["角色"]["背包"]', '0', '"车票"'] }),
+            expect.objectContaining({ type: 'delete', args: ['["角色"]["背包"][1]'] }),
+            expect.objectContaining({ type: 'move', args: ['["角色"]["旧位置"]', '["角色"]["当前位置"]'] }),
+        ]);
+    });
+
+    test('extracts a tagged envelope and treats it as an exclusive command batch', () => {
+        const input = [
+            "_.set('角色.好感度', 999);",
+            '<NoraMvu>',
+            '{"protocol":"nora-mvu/1","operations":[{"op":"set","path":["角色","好感度"],"value":44}]}',
+            '</NoraMvu>',
+        ].join('\n');
+        const extracted = extractNoraMvuCommands(input);
+
+        expect(extracted.matched).toBe(true);
+        expect(extracted.error).toBeUndefined();
+        expect(extracted.commands).toHaveLength(1);
+        expect(extracted.commands[0].args.at(-1)).toBe('44');
+    });
+
+    test('rejects unknown fields, dangerous paths, unknown operations and invalid indexes', () => {
+        expect(() => parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1', operations: [], extra: true,
+        })).toThrow(/unknown fields/);
+        expect(() => parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1', operations: [{ op: 'set', path: ['__proto__'], value: 1 }],
+        })).toThrow(/not writable/);
+        expect(() => parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1', operations: [{ op: 'merge', path: ['x'], value: 1 }],
+        })).toThrow(/unsupported/);
+        expect(() => parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1', operations: [{ op: 'insert', path: ['x'], index: -1, value: 1 }],
+        })).toThrow(/non-negative integer/);
+        expect(() => parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1', operations: [{ op: 'set', path: ['   '], value: 1 }],
+        })).toThrow(/non-empty string/);
+        expect(() => parseNoraMvuEnvelope({
+            protocol: 'nora-mvu/1', operations: [{ op: 'move', from: ['角色'], path: ['角色', '状态'] }],
+        })).toThrow(/own descendant/);
+    });
+
+    test('formats and recognizes an explicit no-op', () => {
+        const block = formatNoraMvuUpdateBlock({ protocol: 'nora-mvu/1', operations: [] });
+        expect(block).toContain('<NoraMvu>{"protocol":"nora-mvu/1","operations":[]}</NoraMvu>');
+        expect(isExplicitNoraMvuNoop(block)).toBe(true);
+    });
+
+    test('reports malformed tagged JSON instead of silently falling back to legacy parsing', () => {
+        const extracted = extractNoraMvuCommands('<NoraMvu>{bad json}</NoraMvu>');
+        expect(extracted.matched).toBe(true);
+        expect(extracted.commands).toEqual([]);
+        expect(extracted.error).toBeInstanceOf(Error);
+    });
+
+    test('rejects duplicate Nora blocks instead of choosing one silently', () => {
+        const block = '<NoraMvu>{"protocol":"nora-mvu/1","operations":[]}</NoraMvu>';
+        const extracted = extractNoraMvuCommands(`${block}\n${block}`);
+        expect(extracted.matched).toBe(true);
+        expect(extracted.commands).toEqual([]);
+        expect(extracted.error?.message).toContain('exactly one');
+    });
+
+    test('rolls the whole batch back when a later operation is invalid', async () => {
+        const variables: any = {
+            initialized_lorebooks: {},
+            stat_data: { score: 1 },
+            display_data: {},
+            delta_data: {},
+        };
+        const block = formatNoraMvuUpdateBlock({
+            protocol: 'nora-mvu/1',
+            operations: [
+                { op: 'set', path: ['score'], value: 2 },
+                { op: 'set', path: ['missing'], value: 3 },
+            ],
+        });
+
+        await expect(updateVariables(block, variables)).resolves.toBe(false);
+        expect(variables.stat_data).toEqual({ score: 1 });
+        expect(getLastVariableUpdateDiagnostics().errors).toHaveLength(1);
+    });
+
+    test('executes move and enforces Nora operation semantics without a Zod card schema', async () => {
+        const variables: any = {
+            initialized_lorebooks: {},
+            stat_data: { actor: { oldPlace: 'train', items: [] } },
+            display_data: {},
+            delta_data: {},
+        };
+        const block = formatNoraMvuUpdateBlock({
+            protocol: 'nora-mvu/1',
+            operations: [
+                { op: 'move', from: ['actor', 'oldPlace'], path: ['actor', 'place'] },
+                { op: 'append', path: ['actor', 'items'], value: 'ticket' },
+            ],
+        });
+
+        await expect(updateVariables(block, variables)).resolves.toBe(true);
+        expect(variables.stat_data).toEqual({ actor: { place: 'train', items: ['ticket'] } });
+    });
+
+    test('rejects non-array append and non-numeric increment without partial writes', async () => {
+        const variables: any = {
+            initialized_lorebooks: {},
+            stat_data: { actor: { items: {}, clock: '2026-09-05T00:00:00.000Z' } },
+            display_data: {},
+            delta_data: {},
+        };
+        const block = formatNoraMvuUpdateBlock({
+            protocol: 'nora-mvu/1',
+            operations: [
+                { op: 'append', path: ['actor', 'items'], value: 'ticket' },
+                { op: 'increment', path: ['actor', 'clock'], amount: 1000 },
+            ],
+        });
+
+        await expect(updateVariables(block, variables)).resolves.toBe(false);
+        expect(variables.stat_data).toEqual({
+            actor: { items: {}, clock: '2026-09-05T00:00:00.000Z' },
+        });
+        expect(getLastVariableUpdateDiagnostics().errors.length).toBeGreaterThan(0);
+    });
+});
