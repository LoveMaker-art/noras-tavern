diff --git a/src/function/nora_protocol.ts b/src/function/nora_protocol.ts
new file mode 100644
index 0000000..e3aa38a
--- /dev/null
+++ b/src/function/nora_protocol.ts
@@ -0,0 +1,301 @@
+export const NORA_MVU_PROTOCOL = 'nora-mvu/1' as const;
+export const NORA_MVU_PROTOCOL_MARKER = /\[nora_mvu\/1\]/i;
+
+const MAX_OPERATIONS = 128;
+const MAX_PATH_DEPTH = 32;
+const MAX_PAYLOAD_CHARS = 262_144;
+const FORBIDDEN_PATH_SEGMENTS = new Set(['__proto__', 'prototype', 'constructor']);
+
+type JsonValue = null | boolean | number | string | JsonValue[] | { [key: string]: JsonValue };
+type NoraMvuPath = Array<string | number>;
+
+type NoraMvuOperation =
+    | { op: 'set'; path: NoraMvuPath; value: JsonValue }
+    | { op: 'increment'; path: NoraMvuPath; amount: number }
+    | { op: 'append'; path: NoraMvuPath; value: JsonValue }
+    | { op: 'insert'; path: NoraMvuPath; index: number; value: JsonValue }
+    | { op: 'delete'; path: NoraMvuPath }
+    | { op: 'move'; from: NoraMvuPath; path: NoraMvuPath };
+
+export type NoraMvuEnvelope = {
+    protocol: typeof NORA_MVU_PROTOCOL;
+    operations: NoraMvuOperation[];
+};
+
+export type NoraMvuCommand = {
+    type: 'set' | 'insert' | 'delete' | 'add' | 'move';
+    full_match: string;
+    args: string[];
+    reason: string;
+};
+
+const path_schema = {
+    type: 'array',
+    minItems: 1,
+    maxItems: MAX_PATH_DEPTH,
+    items: {
+        anyOf: [
+            { type: 'string', minLength: 1 },
+            { type: 'integer', minimum: 0 },
+        ],
+    },
+};
+
+const json_value_schema = {
+    anyOf: [
+        { type: 'string' },
+        { type: 'number' },
+        { type: 'boolean' },
+        { type: 'null' },
+        { type: 'object' },
+        { type: 'array' },
+    ],
+};
+
+const operation_schema = {
+    anyOf: [
+        {
+            type: 'object',
+            additionalProperties: false,
+            properties: {
+                op: { type: 'string', enum: ['set'] },
+                path: path_schema,
+                value: json_value_schema,
+            },
+            required: ['op', 'path', 'value'],
+        },
+        {
+            type: 'object',
+            additionalProperties: false,
+            properties: {
+                op: { type: 'string', enum: ['increment'] },
+                path: path_schema,
+                amount: { type: 'number' },
+            },
+            required: ['op', 'path', 'amount'],
+        },
+        {
+            type: 'object',
+            additionalProperties: false,
+            properties: {
+                op: { type: 'string', enum: ['append'] },
+                path: path_schema,
+                value: json_value_schema,
+            },
+            required: ['op', 'path', 'value'],
+        },
+        {
+            type: 'object',
+            additionalProperties: false,
+            properties: {
+                op: { type: 'string', enum: ['insert'] },
+                path: path_schema,
+                index: { type: 'integer', minimum: 0 },
+                value: json_value_schema,
+            },
+            required: ['op', 'path', 'index', 'value'],
+        },
+        {
+            type: 'object',
+            additionalProperties: false,
+            properties: {
+                op: { type: 'string', enum: ['delete'] },
+                path: path_schema,
+            },
+            required: ['op', 'path'],
+        },
+        {
+            type: 'object',
+            additionalProperties: false,
+            properties: {
+                op: { type: 'string', enum: ['move'] },
+                from: path_schema,
+                path: path_schema,
+            },
+            required: ['op', 'from', 'path'],
+        },
+    ],
+};
+
+export const NORA_MVU_RESPONSE_SCHEMA = Object.freeze({
+    name: 'nora_mvu_v1',
+    description: 'A validated Nora MVU state transition. Return only this object.',
+    // Operation values may contain card-defined objects, which cannot satisfy
+    // every provider's strict-schema subset without a card-specific schema.
+    strict: false,
+    value: {
+        type: 'object',
+        additionalProperties: false,
+        properties: {
+            protocol: { type: 'string', enum: [NORA_MVU_PROTOCOL] },
+            operations: {
+                type: 'array',
+                maxItems: MAX_OPERATIONS,
+                items: operation_schema,
+            },
+        },
+        required: ['protocol', 'operations'],
+    },
+}) satisfies JsonSchema;
+
+export const NORA_MVU_TOOL_PARAMETERS = NORA_MVU_RESPONSE_SCHEMA.value;
+
+export const NORA_MVU_OUTPUT_INSTRUCTION = `
+Return variable changes using Nora MVU protocol v1. Never output _.set, JsonPatch, prose, or markdown inside the update block.
+Use exactly:
+<UpdateVariable><NoraMvu>{"protocol":"nora-mvu/1","operations":[...]}</NoraMvu></UpdateVariable>
+Allowed operations are set(path,value), increment(path,amount), append(path,value), insert(path,index,value), delete(path), and move(from,path).
+Every path is a JSON array of non-empty string keys or non-negative integer indexes. Use {"protocol":"nora-mvu/1","operations":[]} when no variable changes are justified.
+`.trim();
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function assertExactKeys(value: Record<string, unknown>, allowed: string[], label: string) {
+    const expected = new Set(allowed);
+    const unknown = Object.keys(value).filter(key => !expected.has(key));
+    if (unknown.length > 0) throw new Error(`${label} has unknown fields: ${unknown.join(', ')}`);
+}
+
+function parsePath(value: unknown, label: string): NoraMvuPath {
+    if (!Array.isArray(value) || value.length === 0) throw new Error(`${label} must be a non-empty array.`);
+    if (value.length > MAX_PATH_DEPTH) throw new Error(`${label} exceeds ${MAX_PATH_DEPTH} segments.`);
+    return value.map((segment, index) => {
+        if (typeof segment === 'number' && Number.isInteger(segment) && segment >= 0) return segment;
+        if (typeof segment !== 'string' || segment.trim().length === 0) {
+            throw new Error(`${label}[${index}] must be a non-empty string or non-negative integer.`);
+        }
+        if (segment.startsWith('_') || FORBIDDEN_PATH_SEGMENTS.has(segment)) {
+            throw new Error(`${label}[${index}] is not writable.`);
+        }
+        return segment;
+    });
+}
+
+function parseOperation(value: unknown, index: number): NoraMvuOperation {
+    if (!isRecord(value) || typeof value.op !== 'string') {
+        throw new Error(`operations[${index}] must be an object with an op field.`);
+    }
+    const path = parsePath(value.path, `operations[${index}].path`);
+    switch (value.op) {
+        case 'set':
+        case 'append':
+            assertExactKeys(value, ['op', 'path', 'value'], `operations[${index}]`);
+            if (!Object.hasOwn(value, 'value')) throw new Error(`operations[${index}].value is required.`);
+            return { op: value.op, path, value: value.value as JsonValue };
+        case 'increment':
+            assertExactKeys(value, ['op', 'path', 'amount'], `operations[${index}]`);
+            if (typeof value.amount !== 'number' || !Number.isFinite(value.amount)) {
+                throw new Error(`operations[${index}].amount must be a finite number.`);
+            }
+            return { op: value.op, path, amount: value.amount };
+        case 'insert':
+            assertExactKeys(value, ['op', 'path', 'index', 'value'], `operations[${index}]`);
+            if (!Number.isInteger(value.index) || Number(value.index) < 0) {
+                throw new Error(`operations[${index}].index must be a non-negative integer.`);
+            }
+            if (!Object.hasOwn(value, 'value')) throw new Error(`operations[${index}].value is required.`);
+            return { op: value.op, path, index: Number(value.index), value: value.value as JsonValue };
+        case 'delete':
+            assertExactKeys(value, ['op', 'path'], `operations[${index}]`);
+            return { op: value.op, path };
+        case 'move':
+            assertExactKeys(value, ['op', 'from', 'path'], `operations[${index}]`);
+            const from = parsePath(value.from, `operations[${index}].from`);
+            if (from.length === path.length && from.every((segment, part) => segment === path[part])) {
+                throw new Error(`operations[${index}] cannot move a value onto itself.`);
+            }
+            if (from.length < path.length && from.every((segment, part) => segment === path[part])) {
+                throw new Error(`operations[${index}] cannot move a value into its own descendant.`);
+            }
+            return { op: value.op, from, path };
+        default:
+            throw new Error(`operations[${index}].op is unsupported: ${value.op}`);
+    }
+}
+
+export function parseNoraMvuEnvelope(value: unknown): NoraMvuEnvelope {
+    if (!isRecord(value)) throw new Error('Nora MVU payload must be an object.');
+    assertExactKeys(value, ['protocol', 'operations'], 'Nora MVU payload');
+    if (value.protocol !== NORA_MVU_PROTOCOL) throw new Error(`Unsupported Nora MVU protocol: ${String(value.protocol)}`);
+    if (!Array.isArray(value.operations)) throw new Error('Nora MVU operations must be an array.');
+    if (value.operations.length > MAX_OPERATIONS) throw new Error(`Nora MVU operations exceed ${MAX_OPERATIONS}.`);
+    return {
+        protocol: NORA_MVU_PROTOCOL,
+        operations: value.operations.map(parseOperation),
+    };
+}
+
+function pathToCommandPath(path: NoraMvuPath): string {
+    return path.map(segment => typeof segment === 'number'
+        ? `[${segment}]`
+        : `["${segment.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"]`
+    ).join('');
+}
+
+export function envelopeToCommands(envelope: NoraMvuEnvelope): NoraMvuCommand[] {
+    return envelope.operations.map(operation => {
+        const full_match = JSON.stringify(operation);
+        switch (operation.op) {
+            case 'set':
+                return { type: 'set', full_match, args: [pathToCommandPath(operation.path), JSON.stringify(operation.value)], reason: 'nora-mvu/1' };
+            case 'increment':
+                return { type: 'add', full_match, args: [pathToCommandPath(operation.path), JSON.stringify(operation.amount)], reason: 'nora-mvu/1' };
+            case 'append':
+                return { type: 'insert', full_match, args: [pathToCommandPath(operation.path), '"-"', JSON.stringify(operation.value)], reason: 'nora-mvu/1' };
+            case 'insert':
+                return { type: 'insert', full_match, args: [pathToCommandPath(operation.path), String(operation.index), JSON.stringify(operation.value)], reason: 'nora-mvu/1' };
+            case 'delete':
+                return { type: 'delete', full_match, args: [pathToCommandPath(operation.path)], reason: 'nora-mvu/1' };
+            case 'move':
+                return { type: 'move', full_match, args: [pathToCommandPath(operation.from), pathToCommandPath(operation.path)], reason: 'nora-mvu/1' };
+        }
+    });
+}
+
+export type NoraMvuExtraction = {
+    matched: boolean;
+    envelope?: NoraMvuEnvelope;
+    commands: NoraMvuCommand[];
+    error?: Error;
+};
+
+export function extractNoraMvuCommands(input: string): NoraMvuExtraction {
+    const matches = [...input.matchAll(/<nora_?mvu>\s*(?:```(?:json)?\s*)?([\s\S]*?)(?:```\s*)?<\/nora_?mvu>/gi)];
+    if (matches.length === 0) return { matched: false, commands: [] };
+    try {
+        if (matches.length !== 1) throw new Error('Nora MVU response must contain exactly one update block.');
+        const payload = matches[0][1].trim();
+        if (payload.length > MAX_PAYLOAD_CHARS) throw new Error(`Nora MVU payload exceeds ${MAX_PAYLOAD_CHARS} characters.`);
+        const envelope = parseNoraMvuEnvelope(JSON.parse(payload));
+        return { matched: true, envelope, commands: envelopeToCommands(envelope) };
+    } catch (error) {
+        return {
+            matched: true,
+            commands: [],
+            error: error instanceof Error ? error : new Error(String(error)),
+        };
+    }
+}
+
+export function formatNoraMvuUpdateBlock(value: unknown): string {
+    const envelope = parseNoraMvuEnvelope(value);
+    return `<UpdateVariable>\n<NoraMvu>${JSON.stringify(envelope)}</NoraMvu>\n</UpdateVariable>`;
+}
+
+export function isExplicitNoraMvuNoop(input: string): boolean {
+    const result = extractNoraMvuCommands(input);
+    return result.matched && !result.error && result.envelope?.operations.length === 0;
+}
+
+export async function isCurrentCardNoraMvuV1(): Promise<boolean> {
+    try {
+        const lorebook = getCurrentCharPrimaryLorebook();
+        if (!lorebook) return false;
+        const entries = await getLorebookEntries(lorebook);
+        return entries.some(entry => NORA_MVU_PROTOCOL_MARKER.test(String(entry?.comment || '')));
+    } catch {
+        return false;
+    }
+}
