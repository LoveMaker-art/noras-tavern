+    const chat_id = SillyTavern.getCurrentChatId();
+    const started_at = Date.now();
+    const transaction = {
+        message_id,
+        chat_id,
+        mode: 'inline',
+        protocol: access?.protocol,
+        ...(access?.mode === 'extra-model'
+            ? { fallback_reason: 'Extra-model support unavailable; parsed original message.' }
+            : {}),
+        started_at,
+    };
+    let stage = 'update';
+    await eventEmit(variable_events.TRANSACTION_STARTED, {
+        ...transaction,
+        had_snapshot: true,
+    });
+    try {
+        access ??= await captureMvuAccess();
+        const isNora = access.protocol !== 'legacy' && chat_message.role === 'assistant';
+        const is_modified = await updateVariables(
+            access.protocol !== 'legacy' && !isNora ? '' : chat_message.message,
+            variables,
+            {
+                nora: isNora,
+            }
+        );
+        const diagnostics = getLastVariableUpdateDiagnostics();
+        const result = executionResult(diagnostics, false);
+        if (isNora && ['partial', 'rejected', 'unverified'].includes(result.outcome)) {
+            await publishUpdateResult(transaction, {
+                result: { ...result, outcome: 'rejected' },
+                diagnostics,
+                persisted: false,
+            });
+            return false;
+        }
+        await access.assertCurrent();
+        if (
+            SillyTavern.getCurrentChatId() !== chat_id ||
+            getChatMessages(message_id).at(-1)?.message !== chat_message.message
+        ) {
+            throw new MvuCommitError(
+                'MVU_STALE_CHAT',
+                'The active chat or message changed while MVU was updating.'
+            );
+        }
+        stage = 'commit';
+        // Preserve upstream inline partial-update/snapshot behavior. Reporting
