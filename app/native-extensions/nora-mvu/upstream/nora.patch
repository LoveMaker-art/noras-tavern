diff --git a/src/function/update/result.ts b/src/function/update/result.ts
new file mode 100644
index 0000000..0237f7b
--- /dev/null
+++ b/src/function/update/result.ts
@@ -0,0 +1,115 @@
+import { variable_events } from '@/variable_def';
+
+/** Execution evidence, before persistence. The boolean updateVariables API remains upstream-compatible. */
+export type VariableUpdateDiagnostics = {
+    command_count: number;
+    accepted_count: number;
+    modified: boolean;
+    explicit_noop: boolean;
+    payload_present: boolean;
+    errors: Array<{ command: string; content: string }>;
+};
+
+export function emptyDiagnostics(): VariableUpdateDiagnostics {
+    return {
+        command_count: 0,
+        accepted_count: 0,
+        modified: false,
+        explicit_noop: false,
+        payload_present: false,
+        errors: [],
+    };
+}
+
+export function executionResult(diagnostics: VariableUpdateDiagnostics, requireCommands: boolean) {
+    if (diagnostics.errors.length) {
+        return {
+            outcome: diagnostics.accepted_count > 0 ? 'partial' : 'rejected',
+            code: 'MVU_COMMAND_VALIDATION_FAILED',
+            stage: 'validation',
+        };
+    }
+    if (diagnostics.command_count === 0 && !diagnostics.explicit_noop) {
+        return requireCommands || diagnostics.payload_present
+            ? { outcome: 'rejected', code: 'MVU_NO_UPDATE_COMMAND', stage: 'parsing' }
+            : { outcome: 'skipped', code: 'MVU_NO_UPDATE_COMMAND', stage: 'parsing' };
+    }
+    if (diagnostics.accepted_count !== diagnostics.command_count) {
+        // A third-party listener may consume commands without reporting their result.
+        // Neither a state diff nor an empty error array proves those commands succeeded.
+        return { outcome: 'unverified', code: 'MVU_EXECUTION_UNVERIFIED', stage: 'validation' };
+    }
+    return { outcome: diagnostics.modified ? 'updated' : 'unchanged', code: '', stage: 'update' };
+}
+
+export function executionAccepted(result: ReturnType<typeof executionResult>) {
+    return ['updated', 'unchanged', 'partial'].includes(result.outcome);
+}
+
+/** Both update modes publish the same terminal envelope; persistence policy stays with the caller. */
+export async function publishUpdateResult(
+    context: {
+        message_id: number;
+        chat_id: string;
+        mode: string;
+        protocol?: string;
+        fallback_reason?: string;
+        started_at: number;
+    },
+    {
+        diagnostics,
+        result,
+        persisted,
+        error,
+        attempt,
+    }: {
+        diagnostics: VariableUpdateDiagnostics;
+        result: { outcome?: string; code: string; stage: string };
+        persisted: boolean;
+        error?: string;
+        attempt?: number;
+    }
+) {
+    const outcomes: Record<string, string> = {
+        MVU_STALE_CHAT: 'stale',
+        MVU_CANCELLED: 'cancelled',
+        MVU_PERSISTENCE_UNKNOWN: 'persistence-unknown',
+        MVU_EXECUTION_UNVERIFIED: 'unverified',
+    };
+    const outcome = result.outcome ?? outcomes[result.code] ?? 'rejected';
+    const { started_at, ...identity } = context;
+    const detail = {
+        ...identity,
+        ...result,
+        outcome,
+        persisted,
+        diagnostics,
+        duration_ms: Date.now() - started_at,
+        ...(attempt === undefined ? {} : { attempt }),
+        error_code: result.code,
+        error:
+            error ??
+            (diagnostics.errors
+                .map(item => item.content)
+                .join('\n')
+                .slice(0, 800) ||
+                result.code),
+    };
+    await eventEmit(
+        (['updated', 'unchanged', 'skipped'].includes(outcome) || (outcome === 'partial' && persisted))
+            ? variable_events.TRANSACTION_COMMITTED
+            : variable_events.TRANSACTION_FAILED,
+        detail
+    );
+    return outcome;
+}
+
+export class MvuCommitError extends Error {
+    constructor(
+        public code: 'MVU_STALE_CHAT' | 'MVU_PERSISTENCE_UNKNOWN',
+        message: string
+    ) {
+        super(message);
+        this.name = 'MvuCommitError';
+    }
+}
