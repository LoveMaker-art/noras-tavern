diff --git a/src/function/update/access.ts b/src/function/update/access.ts
new file mode 100644
index 0000000..6687819
--- /dev/null
+++ b/src/function/update/access.ts
@@ -0,0 +1,103 @@
+import { useDataStore } from '@/store';
+import { MvuCommitError } from './result';
+
+export function noraBridge(): any {
+    return (window.parent as any).NoraMvu;
+}
+
+async function readAccess() {
+    const book = getCurrentCharPrimaryLorebook();
+    const entries = book ? await getLorebookEntries(book) : [];
+    const settings = useDataStore().effective_settings;
+    const protocol = noraBridge().protocol.resolveMvuProtocol(entries);
+    return {
+        protocol,
+        mode: settings.更新方式 === '随AI输出' ? 'inline' : 'extra-model',
+        // Ephemeral identity only, never logged or sent to a model.
+        identity: JSON.stringify([
+            SillyTavern.getCurrentChatId(),
+            (SillyTavern as any).characterId,
+            book,
+            entries,
+            settings,
+        ]),
+    };
+}
+
+export async function captureMvuAccess() {
+    const captured = await readAccess();
+    const assertCurrent = async () => {
+        let current;
+        try { current = await readAccess(); } catch { /* Changed invalid declarations are stale too. */ }
+        if (current?.identity !== captured.identity) {
+            throw new MvuCommitError('MVU_STALE_CHAT', 'The active card, protocol or settings changed.');
+        }
+    };
+    const query: { schemas: Array<{ fields: unknown }> } = { schemas: [] };
+    // Subscribe before querying: the card helper may still be starting. Keep no
+    // persistent registry and never poll the card or send a model request to test readiness.
+    let wake!: () => void;
+    const ready = new Promise<void>(resolve => { wake = resolve; });
+    const onReady = () => wake();
+    eventOn('nora_mvu_schema_ready', onReady);
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+        await eventEmit('nora_mvu_schema_query', query);
+        if (noraBridge().schemaExpected?.() && query.schemas.length === 0) {
+            await Promise.race([ready, new Promise<void>(resolve => { timer = setTimeout(resolve, 15000); })]);
+            await assertCurrent();
+            query.schemas.length = 0;
+            await eventEmit('nora_mvu_schema_query', query);
+        }
+    } finally {
+        clearTimeout(timer);
+        eventRemoveListener('nora_mvu_schema_ready', onReady);
+    }
+    await assertCurrent();
+    if (noraBridge().schemaExpected?.() && query.schemas.length === 0) {
+        throw Object.assign(
+            new Error('This card declares Zod, but no schema registered for the active card.'),
+            { code: 'MVU_SCHEMA_UNAVAILABLE', stage: 'prepare' }
+        );
+    }
+    return {
+        ...captured,
+        fields: query.schemas.length === 1 ? query.schemas[0].fields : null,
+        assertCurrent,
+    };
+}
+
+export type MvuAccess = Awaited<ReturnType<typeof captureMvuAccess>>;
+let prepared: { chat: string; access: MvuAccess } | undefined;
+
+export async function accessForMessage(force = false) {
+    if (!force && prepared?.chat === SillyTavern.getCurrentChatId()) {
+        await prepared.access.assertCurrent();
+        return prepared.access;
+    }
+    return captureMvuAccess();
+}
+
+export async function prepareMvuPrompt({ messages }: { messages: any[] }) {
+    if (useDataStore().runtimes.is_during_extra_analysis) return;
+    const access = await captureMvuAccess();
+    prepared = { chat: SillyTavern.getCurrentChatId(), access };
+    if (access.protocol === 'legacy') return;
+    const contract = noraBridge().protocol;
+    const inline = access.mode === 'inline';
+    // Only model-bound copies are filtered; stored narrative and Regex are unchanged.
+    for (const message of messages) {
+        if (typeof message.content === 'string' && ['assistant', 'user'].includes(message.role)) {
+            message.content = message.content.replace(
+                /<UpdateVariable>\s*<NoraMvu>[\s\S]*?<\/NoraMvu>\s*<\/UpdateVariable>/g,
+                ''
+            );
+        }
+    }
+    messages.push({
+        role: 'system',
+        content: inline
+            ? contract.noraMvuInstruction({ inline: true, fields: access.fields })
+            : 'Write story only. Nora MVU updates state in a separate request; do not output variable update blocks.',
+    });
+}
